k","label":"Node Installation","href":"/testnets/tacchain/node-installation","docId":"tacchain/node-installation","unlisted":false},{"type":"link","label":"Sync","href":"/testnets/tacchain/sync","docId":"tacchain/sync","unlisted":false},{"type":"link","label":"Upgrade","href":"/testnets/tacchain/upgrade","docId":"tacchain/upgrade","unlisted":false},{"type":"link","label":"Useful Commands","href":"/testnets/tacchain/useful-commands","docId":"tacchain/useful-commands","unlisted":false}],"href":"/testnets/tacchain/"},{"type":"category","label":"Warden","collapsible":true,"collapsed":true,"items":[{"type":"link","label":"Node Installation","href":"/testnets/warden/node-installation","docId":"warden/node-installation","unlisted":false},{"type":"link","label":"Sync","href":"/testnets/warden/sync","docId":"warden/sync","unlisted":false},{"type":"link","label":"Upgrade","href":"/testnets/warden/upgrade","docId":"warden/upgrade","unlisted":false},{"type":"link","label":"Useful Commands","href":"/testnets/warden/useful-commands","docId":"warden/useful-commands","unlisted":false}],"href":"/testnets/warden/"}]},"docs":{"airchain/airchain":{"id":"airchain/airchain","title":"Airchain","description":"Airchains is distinct from RaaS providers because we built our own ZK circuit from the ground up, rather than relying on a third party. We also offer full EVM, SVM, and Cosmwasm support and interoperability, whereas RaaS providers are EVM-only.","sidebar":"testnetsSidebars"},"airchain/node-installation":{"id":"airchain/node-installation","title":"Node Installation","description":"Chain ID v0.3.2 | Custom Port: 20","sidebar":"testnetsSidebars"},"airchain/sync":{"id":"airchain/sync","title":"Sync","description":"Chain ID v0.3.2","sidebar":"testnetsSidebars"},"airchain/upgrade":{"id":"airchain/upgrade","title":"Upgrade","description":"Chain ID v0.3.2","sidebar":"testnetsSidebars"},"airchain/useful-commands":{"id":"airchain/useful-commands","title":"Useful Commands","description":"Chain ID v0.3.2","sidebar":"testnetsSidebars"},"atomone/atomone":{"id":"atomone/atomone","title":"Atomone","description":"Atomone: The vision behind this AtomOne fork is to be an alternative minimal fork of Gaia (\"cosmoshub4\") running alongside Gaia to prepare for all contingencies, and also to operate as a political party base in relation to Gaia. We strive to complement the broader Cosmos ecosystem while introducing innovative solutions and perspectives. Our goals are not just to resolve challenges but are also to set a new precedent for adaptive and responsive self-organization in the multichain multitoken universe that we call the Cosmos.","sidebar":"testnetsSidebars"},"atomone/node-installation":{"id":"atomone/node-installation","title":"Node Installation","description":"Chain ID v4.0.0-rc1 | Custom Port: 31","sidebar":"testnetsSidebars"},"atomone/sync":{"id":"atomone/sync","title":"Sync","description":"Chain ID v3.0.1","sidebar":"testnetsSidebars"},"atomone/upgrade":{"id":"atomone/upgrade","title":"Upgrade","description":"Chain ID v3.0.1","sidebar":"testnetsSidebars"},"atomone/useful-commands":{"id":"atomone/useful-commands","title":"Useful Commands","description":"Chain ID v3.0.1","sidebar":"testnetsSidebars"},"axone/axone":{"id":"axone/axone","title":"Axone","description":"Axone is a Layer-1 blockchain for collaborative AI training, governance, and monetization. It provides a framework with custom conditions ensuring privacy, compatibility, and fair value sharing. Users can build AI ecosystems and access data or infrastructure from web2 and web3 protocols like DePIN, AI, and Data networks.","sidebar":"testnetsSidebars"},"axone/node-installation":{"id":"axone/node-installation","title":"Node Installation","description":"Chain ID v10.0.0 | Custom Port: 44","sidebar":"testnetsSidebars"},"axone/sync":{"id":"axone/sync","title":"Sync","description":"Chain ID v10.0.0","sidebar":"testnetsSidebars"},"axone/upgrade":{"id":"axone/upgrade","title":"Upgrade","description":"Chain ID v10.0.0","sidebar":"testnetsSidebars"},"axone/useful-commands":{"id":"axone/useful-commands","title":"Useful Commands","description":"Chain ID v10.0.0","sidebar":"testnetsSidebars"},"cardchain/cardchain":{"id":"cardchain/cardchain","title":"Cardchain","description":"As a blockchain game DAO we are set to solve an everlasting game development problem. In the development of game content, the player feedback loop underlies a big time delay and the user feedback is detached from the actual content development. This leads to imbalanced games, undesired features and ultimately to player and developer frustrations. We are solving this problem by integrating blockchain technology, which allows the player to create and balance their own in-game content in an automated feedback loop.","sidebar":"testnetsSidebars"},"cardchain/node-installation":{"id":"cardchain/node-installation","title":"Node Installation","description":"Chain ID v0.16.0 | Custom Port: 21","sidebar":"testnetsSidebars"},"cardchain/sync":{"id":"cardchain/sync","title":"Sync","description":"Chain ID v0.16.0","sidebar":"testnetsSidebars"},"cardchain/upgrade":{"id":"cardchain/upgrade","title":"Upgrade","description":"Chain ID v0.16.0","sidebar":"testnetsSidebars"},"cardchain/useful-commands":{"id":"cardchain/useful-commands","title":"Useful Commands","description":"Chain ID v0.16.0","sidebar":"testnetsSidebars"},"empeiria/empeiria":{"id":"empeiria/empeiria","title":"Empeiria","description":"Empeiria is the first End-to-End Verifiable Data Infrastructure (EVDI). It enables seamless web3 adoption through one-click deployment, empowering organizations with the data of the future.","sidebar":"testnetsSidebars"},"empeiria/node-installation":{"id":"empeiria/node-installation","title":"Node Installation","description":"Chain ID v0.2.2 | Custom Port: 23","sidebar":"testnetsSidebars"},"empeiria/sync":{"id":"empeiria/sync","title":"Sync","description":"Chain ID v0.2.2","sidebar":"testnetsSidebars"},"empeiria/upgrade":{"id":"empeiria/upgrade","title":"Upgrade","description":"Chain ID v0.2.2","sidebar":"testnetsSidebars"},"empeiria/useful-commands":{"id":"empeiria/useful-commands","title":"Useful Commands","description":"Chain ID v0.2.2","sidebar":"testnetsSidebars"},"fuel/fuel":{"id":"fuel/fuel","title":"Fuel","description":"Fuel is an operating system purpose built for Ethereum Rollups. Fuel allows rollups to solve for PSI (parallelization, state minimized execution, interoperability) without making any sacrifices.","sidebar":"testnetsSidebars"},"fuel/node-installation":{"id":"fuel/node-installation","title":"Node Installation","description":"Chain ID seq-testnet-2.2 | Custom Port: 38","sidebar":"testnetsSidebars"},"fuel/sync":{"id":"fuel/sync","title":"Sync","description":"Chain ID seq-testnet-2.2","sidebar":"testnetsSidebars"},"fuel/upgrade":{"id":"fuel/upgrade","title":"Upgrade","description":"Chain ID seq-testnet-2.2","sidebar":"testnetsSidebars"},"fuel/useful-commands":{"id":"fuel/useful-commands","title":"Useful Commands","description":"Chain ID seq-testnet-2.2","sidebar":"testnetsSidebars"},"galactica/galactica":{"id":"galactica/galactica","title":"Galactica","description":"Galactica Network is an EVM L1 powered by Cosmos SDK. Among the core features are contingent transactions, zkCertificates and KYC Guardians.","sidebar":"testnetsSidebars"},"galactica/node-installation":{"id":"galactica/node-installation","title":"Node Installation","description":"Chain ID v0.1.2 | Custom Port: 32","sidebar":"testnetsSidebars"},"galactica/sync":{"id":"galactica/sync","title":"Sync","description":"Chain ID v0.1.2","sidebar":"testnetsSidebars"},"galactica/upgrade":{"id":"galactica/upgrade","title":"Upgrade","description":"Chain ID v0.1.2","sidebar":"testnetsSidebars"},"galactica/useful-commands":{"id":"galactica/useful-commands","title":"Useful Commands","description":"Chain ID v0.1.2","sidebar":"testnetsSidebars"},"gnoland/gnoland":{"id":"gnoland/gnoland","title":"Gnoland","description":"Gno.land is a next-generation smart contract platform using Gno, an interpreted version of the general-purpose Go programming language. On Gno.land, smart contracts can be uploaded on-chain only by publishing their full source code, making it trivial to verify the contract or fork it into an improved version. With a system to publish reusable code libraries on-chain, Gno.land serves as the “GitHub” of the ecosystem, with realms built using fully transparent, auditable code that anyone can inspect and reuse.","sidebar":"testnetsSidebars"},"gnoland/node-installation":{"id":"gnoland/node-installation","title":"Node Installation","description":"Chain ID chain/test11 | Custom Port: 42","sidebar":"testnetsSidebars"},"gnoland/sync":{"id":"gnoland/sync","title":"Sync","description":"Chain ID chain/test11","sidebar":"testnetsSidebars"},"gnoland/upgrade":{"id":"gnoland/upgrade","title":"Upgrade","description":"Chain ID chain/test11","sidebar":"testnetsSidebars"},"gnoland/useful-commands":{"id":"gnoland/useful-commands","title":"Useful Commands","description":"Chain ID chain/test11","sidebar":"testnetsSidebars"},"hippo/hippo":{"id":"hippo/hippo","title":"Hippo Protocol","description":"Hippo Protocol is a purpose-built Layer 1 designed to unify fragmented healthcare systems with interoperable, privacy-preserving infrastructure.","sidebar":"testnetsSidebars"},"hippo/node-installation":{"id":"hippo/node-installation","title":"Node Installation","description":"Chain ID v2.0.0 | Custom Port: 37","sidebar":"testnetsSidebars"},"hippo/sync":{"id":"hippo/sync","title":"Sync","description":"Chain ID v1.0.1","sidebar":"testnetsSidebars"},"hippo/upgrade":{"id":"hippo/upgrade","title":"Upgrade","description":"Chain ID v1.0.1","sidebar":"testnetsSidebars"},"hippo/useful-commands":{"id":"hippo/useful-commands","title":"Useful Commands","description":"Chain ID v1.0.1","sidebar":"testnetsSidebars"},"index":{"id":"index","title":"Testnets","description":"Shazoes is a validator that prioritizes stability, security, and maximum performance when supporting blockchain networks. With dependable infrastructure, we ensure that our nodes are constantly operational and provide public services to benefit the blockchain community.","sidebar":"testnetsSidebars"},"lumera/lumera":{"id":"lumera/lumera","title":"Lumera","description":"Lumera Protocol is a high-performance blockchain purpose-built for AI-driven Web3 economies, integrating a Validator-SuperNode architecture to enable decentralized AI services, trustless computation, and secure data storage.","sidebar":"testnetsSidebars"},"lumera/node-installation":{"id":"lumera/node-installation","title":"Node Installation","description":"Chain ID v1.7.0 | Custom Port: 40","sidebar":"testnetsSidebars"},"lumera/sync":{"id":"lumera/sync","title":"Sync","description":"Chain ID v1.7.0","sidebar":"testnetsSidebars"},"lumera/upgrade":{"id":"lumera/upgrade","title":"Upgrade","description":"Chain ID v1.7.0","sidebar":"testnetsSidebars"},"lumera/useful-commands":{"id":"lumera/useful-commands","title":"Useful Commands","description":"Chain ID v1.7.0","sidebar":"testnetsSidebars"},"push/node-installation":{"id":"push/node-installation","title":"Node Installation","description":"Chain ID v0.0.15 | Custom Port: 44","sidebar":"testnetsSidebars"},"push/push":{"id":"push/push","title":"Push","description":"Push Chain is the first True Universal Layer 1 blockchain, built as a 100% EVM-compatible Proof of Stake (PoS) chain. It runs seamlessly across every chain and wallet.","sidebar":"testnetsSidebars"},"push/sync":{"id":"push/sync","title":"Sync","description":"Chain ID v0.0.15","sidebar":"testnetsSidebars"},"push/upgrade":{"id":"push/upgrade","title":"Upgrade","description":"Chain ID v0.0.15","sidebar":"testnetsSidebars"},"push/useful-commands":{"id":"push/useful-commands","title":"Useful Commands","description":"Chain ID v0.0.15","sidebar":"testnetsSidebars"},"seda/node-installation":{"id":"seda/node-installation","title":"Node Installation","description":"Chain ID v1.0.0-rc.4 | Custom Port: 43","sidebar":"testnetsSidebars"},"seda/seda":{"id":"seda/seda","title":"Seda","description":"SEDA is a standard for modular data transport and querying. Any data type, for all networks.","sidebar":"testnetsSidebars"},"seda/sync":{"id":"seda/sync","title":"Sync","description":"Chain ID v1.0.0-rc.4","sidebar":"testnetsSidebars"},"seda/upgrade":{"id":"seda/upgrade","title":"Upgrade","description":"Chain ID v1.0.0-rc.4","sidebar":"testnetsSidebars"},"seda/useful-commands":{"id":"seda/useful-commands","title":"Useful Commands","description":"Chain ID v1.0.0-rc.4","sidebar":"testnetsSidebars"},"soarchain/node-installation":{"id":"soarchain/node-installation","title":"Node Installation","description":"Chain ID v0.2.9 | Custom Port: 37","sidebar":"testnetsSidebars"},"soarchain/soarchain":{"id":"soarchain/soarchain","title":"Soarchain","description":"Soarchain, a Layer 1 Network, aims to establish a decentralized ecosystem where participants, including vehicles, data providers, and developers, can interact and exchange value securely. It provides a platform for developers to build customized smart contracts and dApps specific to the mobility industry, fostering innovation and collaboration.","sidebar":"testnetsSidebars"},"soarchain/sync":{"id":"soarchain/sync","title":"Sync","description":"Chain ID v0.2.9","sidebar":"testnetsSidebars"},"soarchain/upgrade":{"id":"soarchain/upgrade","title":"Upgrade","description":"Chain ID v0.2.9","sidebar":"testnetsSidebars"},"soarchain/useful-commands":{"id":"soarchain/useful-commands","title":"Useful Commands","description":"Chain ID v0.2.9","sidebar":"testnetsSidebars"},"story/node-installation":{"id":"story/node-installation","title":"Node Installation","description":"Chain ID v1.3.0 | Custom Port: 36","sidebar":"testnetsSidebars"},"story/story":{"id":"story/story","title":"Story","description":"Story is the World's IP Blockchain that transforms intelligence into Programmable IP assets.","sidebar":"testnetsSidebars"},"story/sync":{"id":"story/sync","title":"Sync","description":"Chain ID v1.3.0","sidebar":"testnetsSidebars"},"story/upgrade":{"id":"story/upgrade","title":"Upgrade","description":"Chain ID v1.3.0","sidebar":"testnetsSidebars"},"story/useful-commands":{"id":"story/useful-commands","title":"Useful Commands","description":"Chain ID v1.3.0","sidebar":"testnetsSidebars"},"structs/node-installation":{"id":"structs/node-installation","title":"Node Installation","description":"Chain ID v0.6.0-beta | Custom Port: 25","sidebar":"testnetsSidebars"},"structs/structs":{"id":"structs/structs","title":"Structs","description":"Struct is a strategic game of interstellar enterprise and empire. In the distant future, the species of the galaxy are embroiled in a race for Alpha Matter, the rare and dangerous substance that fuels galactic civilization.","sidebar":"testnetsSidebars"},"structs/sync":{"id":"structs/sync","title":"Sync","description":"Chain ID v0.6.0-beta","sidebar":"testnetsSidebars"},"structs/upgrade":{"id":"structs/upgrade","title":"Upgrade","description":"Chain ID v0.6.0-beta","sidebar":"testnetsSidebars"},"structs/useful-commands":{"id":"structs/useful-commands","title":"Useful Commands","description":"Chain ID v0.6.0-beta","sidebar":"testnetsSidebars"},"symphony/node-installation":{"id":"symphony/node-installation","title":"Node Installation","description":"Chain ID v5testnet | Custom Port: 27","sidebar":"testnetsSidebars"},"symphony/symphony":{"id":"symphony/symphony","title":"Symphony","description":"Symphony is a Cosmos-based blockchain enabling global trading of real-world assets, like real estate and gold, without relying on traditional banking infrastructure, offering crypto-native solutions.","sidebar":"testnetsSidebars"},"symphony/sync":{"id":"symphony/sync","title":"Sync","description":"Chain ID v5testnet","sidebar":"testnetsSidebars"},"symphony/upgrade":{"id":"symphony/upgrade","title":"Upgrade","description":"Chain ID v5testnet","sidebar":"testnetsSidebars"},"symphony/useful-commands":{"id":"symphony/useful-commands","title":"Useful Commands","description":"Chain ID v5testnet","sidebar":"testnetsSidebars"},"tacchain/node-installation":{"id":"tacchain/node-installation","title":"Node Installation","description":"Chain ID v0.0.11 | Custom Port: 41","sidebar":"testnetsSidebars"},"tacchain/sync":{"id":"tacchain/sync","title":"Sync","description":"Chain ID v0.0.11","sidebar":"testnetsSidebars"},"tacchain/tacchain":{"id":"tacchain/tacchain","title":"Tacchain","description":"TAC is a purpose-built blockchain for EVM dApps to access TON and Telegram Ecosystem’s 1B+ user base.","sidebar":"testnetsSidebars"},"tacchain/upgrade":{"id":"tacchain/upgrade","title":"Upgrade","description":"Chain ID v0.0.11","sidebar":"testnetsSidebars"},"tacchain/useful-commands":{"id":"tacchain/useful-commands","title":"Useful Commands","description":"Chain ID v0.0.11","sidebar":"testnetsSidebars"},"warden/node-installation":{"id":"warden/node-installation","title":"Node Installation","description":"Chain ID v0.7.0-rc3 | Custom Port: 29","sidebar":"testnetsSidebars"},"warden/sync":{"id":"warden/sync","title":"Sync","description":"Chain ID v0.7.0-rc3","sidebar":"testnetsSidebars"},"warden/upgrade":{"id":"warden/upgrade","title":"Upgrade","description":"Chain ID v0.7.0-rc3","sidebar":"testnetsSidebars"},"warden/useful-commands":{"id":"warden/useful-commands","title":"Useful Commands","description":"Chain ID v0.7.0-rc3","sidebar":"testnetsSidebars"},"warden/warden":{"id":"warden/warden","title":"Warden","description":"Warden Protocol is a Layer 1 blockchain designed to bring AI capabilities to the Web3 ecosystem. It enables developers to integrate AI directly into applications, protocols, or smart contracts, ensuring safe and seamless AI interactions.","sidebar":"testnetsSidebars"}}}}